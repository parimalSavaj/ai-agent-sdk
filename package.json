{
  "name": "sugam",
  "version": "1.0.0",
  "description": "A TypeScript AI agent SDK — tools, memory, streaming, guardrails, handoffs, and multi-provider support.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "example:basic": "node --env-file=.env dist/examples/basic-agent.js",
    "example:weather": "node --env-file=.env dist/examples/weather-agent.js",
    "example:local": "node --env-file=.env dist/examples/local-model.js",
    "example:test-providers": "node --env-file=.env dist/examples/test-providers.js",
    "example:stream": "node --env-file=.env dist/examples/streaming-chat.js",
    "example:memory": "node --env-file=.env dist/examples/memory-chat.js",
    "example:structured": "node --env-file=.env dist/examples/structured-output.js",
    "example:guardrails": "node --env-file=.env dist/examples/guardrails.js",
    "example:handoffs": "node --env-file=.env dist/examples/handoffs.js",
    "example:reliability": "node --env-file=.env dist/examples/reliability.js",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "ai",
    "agent",
    "sdk",
    "llm",
    "openai",
    "anthropic",
    "tools",
    "streaming",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "openai": "^7.2.0",
    "zod": "^4.4.3"
  }
}
